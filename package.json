{
  "name": "@arrmee/tree-sitter-vba",
  "version": "1.0.2",
  "description": "Tree-sitter grammar for Visual Basic for Applications (VBA)",
  "license": "GPL-3.0",
  "author": "arrmee-wt <https://github.com/arrmee-wt>",
  "homepage": "https://github.com/arrmee-wt/tree-sitter-vba",
  "repository": {
    "type": "git",
    "url": "https://github.com/arrmee-wt/tree-sitter-vba.git"
  },
  "bugs": "https://github.com/arrmee-wt/tree-sitter-vba/issues",
  "keywords": [
    "tree-sitter",
    "vba",
    "parser",
    "grammar",
    "visual-basic",
    "ast"
  ],
  "main": "bindings/node",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node",
    "prebuilds",
    "src",
